---
fabric-1.21.8:
  gradle: |
    repositories {
      maven { url "https://api.modrinth.com/maven" }
      maven { url "https://maven.shedaniel.me/" }
      maven { url "https://maven.architectury.dev/" }
      mavenCentral()
    }

    dependencies {
      modLocalRuntime "maven.modrinth:appleskin:3.0.6+mc1.21.6" // 1.21.8
      modImplementation "me.shedaniel.cloth:cloth-config-fabric:15.0.140" // 1.21.8
      compileOnly "org.jetbrains:annotations:24.0.1"
    }
  update_files:
    - ~
name: "AppleSkin"
