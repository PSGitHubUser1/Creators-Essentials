---
fabric-1.21.8:
  gradle: |
    repositories {
      maven {
        url = "https://cursemaven.com"
        content { includeGroup "curse.maven" }
      }
      maven {
        url = "https://api.modrinth.com/maven"
        content { includeGroup "maven.modrinth" }
      }
      maven { url = "https://maven.fabricmc.net" }
      mavenCentral()
    }

    dependencies {
      modCompileOnly "curse.maven:fast-async-world-save-forge-fabric-951499:6868472" // 1.21.8
      modLocalRuntime "curse.maven:fast-async-world-save-forge-fabric-951499:6868472" // 1.21.8

      modCompileOnly "curse.maven:loot-integrations-580689:6863911" // 1.21.8
      modLocalRuntime "curse.maven:loot-integrations-580689:6863911" // 1.21.8

      // modCompileOnly "curse.maven:cupboard-326652:6863467" // 1.21.8
      // modLocalRuntime "curse.maven:cupboard-326652:6863467" // 1.21.8
    }
  update_files:
    - ~
name: "Someaddon Mods"
